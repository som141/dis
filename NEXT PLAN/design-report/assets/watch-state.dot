digraph G {
  graph [bgcolor="transparent", rankdir=LR, pad="0.2", nodesep="0.36", ranksep="0.55", fontname="Noto Sans CJK KR"];
  node [shape=rect, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=10.5, color="#CBD5E1", margin="0.12,0.08", fillcolor="#F8FAFC"];
  edge [fontname="Noto Sans CJK KR", fontsize=8.5, color="#64748B", fontcolor="#475569", arrowsize=0.6];

  draft [label="DRAFT\n조건 작성", fillcolor="#F8FAFC"];
  arming [label="ARMING\n첫 전체 조회", fillcolor="#FFF7ED", color="#F59E0B"];
  active [label="ACTIVE\n30분 감시", fillcolor="#ECFDF5", color="#10B981"];
  paused [label="PAUSED\n사용자 일시정지", fillcolor="#EFF6FF", color="#3B82F6"];
  auth [label="AUTH_REQUIRED\n재로그인 필요", fillcolor="#FEF2F2", color="#EF4444"];
  rate [label="RATE_LIMITED\n한도 대기", fillcolor="#FFF1F2", color="#F43F5E"];
  expired [label="EXPIRED\n기간 종료", fillcolor="#F1F5F9"];
  cancelled [label="CANCELLED\n사용자 종료", fillcolor="#F1F5F9"];

  draft -> arming [label="최종 확인"];
  arming -> active [label="기준선 완료"];
  arming -> arming [label="부분/실패"];
  active -> paused [label="일시정지"];
  paused -> arming [label="재개·revision+"];
  active -> auth [label="401/세션 변경"];
  auth -> arming [label="재인증"];
  active -> rate [label="잔여량 부족"];
  rate -> active [label="리셋·재계산"];
  active -> expired [label="expires_at"];
  active -> cancelled [label="사용자 중지"];
  paused -> cancelled;
  auth -> cancelled;
  rate -> cancelled;
}
