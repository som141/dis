  service [label="메이플 추천 서비스\n조건 고정 · 검색 · 평가 · 감시", fillcolor="#ECFDF5", color="#10B981", penwidth=2.2];
  character [label="캐릭터 Open API\n닉네임 · 직업 · 현재 장비", fillcolor="#EFF6FF", color="#3B82F6"];
  browser [label="경매장 세션 실행기\n로그인된 브라우저 안에서 조회", fillcolor="#FEF2F2", color="#EF4444"];
  auction [label="공식 웹 경매장\n매물 · 가격 · 옵션 · 한도", fillcolor="#F8FAFC"];

  user -> discord [label="명령·선택"];
  discord -> service [label="검증된 요청"];
  service -> discord [label="개인 결과·알림"];
  user -> web [label="선택 연결"];
  web -> service [label="연결 상태만"];
