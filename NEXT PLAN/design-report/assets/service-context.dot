digraph G {
  graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.48", ranksep="0.8", fontname="Noto Sans CJK KR"];
  node [shape=rect, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=12, color="#CBD5E1", penwidth=1.3, margin="0.16,0.11"];
  edge [fontname="Noto Sans CJK KR", fontsize=9.5, color="#64748B", fontcolor="#475569", penwidth=1.2, arrowsize=0.7];

  user [label="사용자\n검색·비교·감시", fillcolor="#FFF7ED", color="#F59E0B"];
  discord [label="Discord\n/아이템 · 개인 패널 · DM", fillcolor="#EEF2FF", color="#6366F1"];
